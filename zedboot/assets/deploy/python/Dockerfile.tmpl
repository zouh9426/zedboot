# ============================================================
# Python（FastAPI / Flask）通用生产 Dockerfile（多阶段，zedboot skill 模板）
#
# 用法：
#   - 本模板落地为项目根目录的 `Dockerfile`
#   - 配套同目录 `docker-entrypoint.sh.tmpl` → 项目根目录 `docker-entrypoint.sh`
#   - 配套 `assets/deploy/docker-compose.yml.tmpl`（容器端口改 8000）
#   - 假设：requirements.txt
#
# 迁移命令位：有数据库迁移时在 entrypoint 中启用对应命令（如 alembic upgrade head）；
#             无迁移则删除 entrypoint 中的迁移相关行。
# 数据目录权限：宿主机 ./data 需可被容器用户写入（如 chown 到容器用户 uid，
#             或放宽目录权限），否则绑定挂载后容器内不可写。
# 设计点对应 references/deployment-guide.md §3。
# ============================================================

# ---- 阶段 1: builder（安装依赖到独立前缀）----
FROM python:3.12-slim AS builder
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir --prefix=/install -r requirements.txt

# ---- 阶段 2: runner（最小运行时）----
FROM python:3.12-slim AS runner
WORKDIR /app
# 只拷贝 /install 下的依赖（bin + lib/site-packages），镜像更小
COPY --from=builder /install /usr/local
COPY . .

# 非 root 运行
RUN useradd -m appuser && mkdir -p /app/data && chown -R appuser:appuser /app
USER appuser

COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/docker-entrypoint.sh

# 数据卷：数据库与上传文件持久化（compose 绑定挂载 ./data:/app/data）
VOLUME /app/data

EXPOSE 8000
ENTRYPOINT ["/app/docker-entrypoint.sh"]
