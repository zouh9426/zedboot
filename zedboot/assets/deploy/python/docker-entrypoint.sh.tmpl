#!/bin/sh
# ============================================================
# 容器启动入口（zedboot skill 模板，落地为项目根目录 docker-entrypoint.sh）
# 通用 Python（FastAPI / Flask）；迁移命令按项目填写。
# 设计点：set -e + 先迁移后启动 + exec 成为 PID 1（deployment-guide.md §3）
# ============================================================
set -e

# 先确保数据目录存在
mkdir -p /app/data

# 迁移命令位：有数据库迁移时取消注释并换成项目的迁移命令（示例：alembic）
# echo "[entrypoint] 执行数据库迁移…"
# alembic upgrade head

echo "[entrypoint] 启动服务…"
# 启动命令按项目修改（示例：FastAPI + uvicorn）
exec uvicorn app.main:app --host 0.0.0.0 --port 8000
