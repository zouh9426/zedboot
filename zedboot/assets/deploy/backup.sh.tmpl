#!/bin/bash
# ============================================================
# 项目备份脚本（zedboot skill 模板）
# 部署：归属项目账号，加入其 crontab。真实调度时间与日志路径属不可推导
#   运维值，写入本地 docs/private/ops.md（不入库），脚本与入库文档只写占位符：
#   <MIN> <HOUR> * * * <PROJECT_DIR>/backup.sh >> <PROJECT_DIR>/backups/backup.log 2>&1
# 前置：宿主机已装 sqlite3（SQLite 在线备份用）
# 对应 references/deployment-guide.md §2/§8（SQLite 在线备份一致性、异地容灾）
# ============================================================

set -euo pipefail

# ---- 路径自推导（脚本落盘在项目根目录，项目目录由脚本自身位置推出，不写死真实路径）----
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_NAME="$(basename "${PROJECT_DIR}")"
DATA_DIR="${PROJECT_DIR}/data"
BACKUP_DIR="${PROJECT_DIR}/backups"
KEEP_N=7                    # 滚动保留最近 N 份（默认 7，可改）

# 若项目用 SQLite，确认库文件名与实际一致；无 SQLite 则留空。
# 设计：先 sqlite3 在线备份保证一致性，再打包数据目录。
SQLITE_DB="${DATA_DIR}/${PROJECT_NAME}.db"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)   # 文件名按时间序，供滚动保留排序

# ---- 0. data/ 存在性守卫：无应用数据（如静态站误装本脚本）时说明并退出，不产残缺包 ----
# 静态站无 data/，其数据备份由 zedback 经 docs/private/backup-manifest.conf 的
# ZB_PULLS 拉取 dist/ 承担，不依赖本脚本；此处兜底让误装也无害。
if [ ! -d "${DATA_DIR}" ]; then
  echo "[backup] 未找到数据目录 ${DATA_DIR}，无应用数据可备份，跳过（静态站等无数据项目的备份由 zedback 经 ZB_PULLS 拉取 dist/ 承担）"
  exit 0
fi

mkdir -p "${BACKUP_DIR}"

# ---- 1. SQLite 在线备份（库存在才执行；失败只告警不中止——tar 打包仍是主备份）----
if [ -f "${SQLITE_DB}" ]; then
  echo "[backup] SQLite 在线备份（一致性副本）…"
  if ! sqlite3 "${SQLITE_DB}" ".backup '${BACKUP_DIR}/${PROJECT_NAME}-${TIMESTAMP}.sqlite3'"; then
    echo "[backup] 警告：SQLite 在线备份失败（库文件损坏或非 SQLite 格式），跳过一致性副本，继续打包" >&2
    rm -f -- "${BACKUP_DIR}/${PROJECT_NAME}-${TIMESTAMP}.sqlite3"   # 清掉半成品，防滚动保留漏管的孤儿文件
  fi
fi

# ---- 2. 打包数据目录 ----
ARCHIVE="${BACKUP_DIR}/${PROJECT_NAME}-${TIMESTAMP}.tar.gz"
echo "[backup] 打包数据目录 → ${ARCHIVE}"
tar -czf "${ARCHIVE}" -C "$(dirname "${DATA_DIR}")" "$(basename "${DATA_DIR}")"

# ---- 3. 滚动保留最近 N 份（时间戳 %Y%m%d-%H%M%S 字典序即时间序）----
# 每份备份 = 同时间戳的 tar.gz（必有）+ 可选 .sqlite3（SQLite 一致副本）
count=0
for f in "${BACKUP_DIR}"/${PROJECT_NAME}-*.tar.gz; do
  [ -e "$f" ] || continue
  count=$((count + 1))
done
if [ "$count" -gt "$KEEP_N" ]; then
  del=$((count - KEEP_N))
  for f in "${BACKUP_DIR}"/${PROJECT_NAME}-*.tar.gz; do
    [ -e "$f" ] || continue
    if [ "$del" -gt 0 ]; then
      rm -f -- "$f"
      rm -f -- "${f%.tar.gz}.sqlite3"   # 连同同时间戳的 SQLite 一致副本一起删
      del=$((del - 1))
    fi
  done
fi

echo "[backup] 完成。"

# ---- 可选：同步到对象存储做异地容灾（rclone / ossutil 等）----
# 例：rclone copy "${ARCHIVE}" "remote:<bucket>/<项目名>/"
