#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# 静态站发布脚本（本地执行，zedboot skill 模板）
# 流程：本地 `npm run build` → 本脚本只同步发布目录 → 服务器 Caddy 直接伺服
# 落地：复制到本地项目根目录为 deploy-rsync-static.sh
# 隐私线：本脚本入库，只保留占位符；部署六事实（项目名/账号/目录/IP/密钥）
#   统一存本地 docs/private/deploy.env（已 gitignore，永不入库），本脚本自动 source
# 对应 references/deployment-guide.md §4 与 assets/deploy/static/README.md
# ============================================================

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 部署事实来自 docs/private/deploy.env（三事实分离，不从路径推导）
if [ -f "${PROJECT_DIR}/docs/private/deploy.env" ]; then
  # shellcheck disable=SC1091
  . "${PROJECT_DIR}/docs/private/deploy.env"
fi
: "${PROJECT_NAME:?请在 docs/private/deploy.env 中设置 PROJECT_NAME}"
: "${DEPLOY_USER:?请在 docs/private/deploy.env 中设置 DEPLOY_USER}"
: "${REMOTE_DIR:?请在 docs/private/deploy.env 中设置 REMOTE_DIR}"
: "${SERVER_IP:?请在 docs/private/deploy.env 中设置 SERVER_IP}"
: "${DEPLOY_KEY:?请在 docs/private/deploy.env 中设置 DEPLOY_KEY}"
# SSH 端口：默认 22（旧 deploy.env 无此字段时保持兼容）；非 22 时在 deploy.env 中设 SSH_PORT
SSH_PORT="${SSH_PORT:-22}"

# ---- 形态适配：发布目录由 STATIC_OUTPUT_DIR 控制（fail-closed，绝不发布项目根）----
# 发布目录按框架：Vite/Astro=dist，Next.js 静态导出=out，纯 HTML=public；
# 非默认值时在 docs/private/deploy.env 中设 STATIC_OUTPUT_DIR
STATIC_OUTPUT_DIR="${STATIC_OUTPUT_DIR:-dist}"
SOURCE_DIR="${PROJECT_DIR}/${STATIC_OUTPUT_DIR}"
if [ ! -d "${SOURCE_DIR}" ]; then
  echo "未找到发布目录 ${SOURCE_DIR}。" >&2
  echo "请先构建，或按框架设置 STATIC_OUTPUT_DIR（Vite/Astro=dist，Next.js 静态导出=out，纯 HTML=public）。" >&2
  exit 1
fi

# 越界防护：发布目录必须是项目内的子目录（canonical path 校验，POSIX 便携，
# 不依赖 realpath -m）。STATIC_OUTPUT_DIR=. 或 ../x 等越出项目根的路径一律拒绝，
# 防止误把整棵项目树（含 docs/private 等）推到服务器。
PROJECT_ABS="$(cd "${PROJECT_DIR}" && pwd -P)"
SOURCE_ABS="$(cd "${SOURCE_DIR}" && pwd -P)"
if [ "${SOURCE_ABS}" = "${PROJECT_ABS}" ] || [ "${SOURCE_ABS#"${PROJECT_ABS}/"}" = "${SOURCE_ABS}" ]; then
  echo "STATIC_OUTPUT_DIR 必须指向项目内的子目录（当前解析为 ${SOURCE_ABS}）。" >&2
  exit 1
fi

# ---- 同步网页文件（只推发布目录，排除敏感与备份）----
echo "[deploy] 同步 ${SOURCE_DIR}/ → ${DEPLOY_USER}@${SERVER_IP}:${REMOTE_DIR}/"
rsync -az --delete \
  --exclude .git --exclude '.env*' --exclude backups \
  --exclude docs/private \
  -e "ssh -i ${DEPLOY_KEY} -p ${SSH_PORT}" \
  "${SOURCE_DIR}/" "${DEPLOY_USER}@${SERVER_IP}:${REMOTE_DIR}/"

echo "[deploy] 完成。Caddy 直接伺服该目录，无需重启；"
echo "        仅当改动服务器 Caddyfile 后才需 caddy reload。"
