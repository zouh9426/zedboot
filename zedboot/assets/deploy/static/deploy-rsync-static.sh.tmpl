#!/usr/bin/env bash
set -euo pipefail

# ============================================================
# 静态站发布脚本（本地执行，zedboot skill 模板）
# 流程：本地 `npm run build` → 本脚本只同步 dist/ → 服务器 Caddy 直接伺服
# 落地：复制到本地项目根目录为 deploy-rsync-static.sh
# 隐私线：本脚本入库，只保留占位符；真实值统一存本地 docs/private/ops.md
#   （已 gitignore，永不入库），部署时经环境变量传入：
#     PRODUCTION_SERVER_IP=… ./deploy-rsync-static.sh
# 对应 references/deployment-guide.md §4 与 assets/deploy/static/README.md
# ============================================================

# ---- 路径自推导（脚本落盘在项目根目录；本地目录名 = 项目名 = 服务器 /opt/ 目录名）----
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_NAME="$(basename "${PROJECT_DIR}")"

# ---- 变量区（默认值均为可推导约定；隔离真实值经环境变量传入，见 docs/private/ops.md）----
DEPLOY_USER="${DEPLOY_USER:-${PROJECT_NAME}}"                 # 默认约定：账号 = 项目名
SERVER_IP="${PRODUCTION_SERVER_IP:-<PRODUCTION_SERVER_IP>}"   # 真实值见 docs/private/ops.md，不入库
SSH_KEY="${DEPLOY_KEY:-~/.ssh/${PROJECT_NAME}_deploy}"        # 默认约定；偏离时经 DEPLOY_KEY 传入
REMOTE_DIR="/opt/${PROJECT_NAME}/dist"

if [[ "${SERVER_IP}" == "<PRODUCTION_SERVER_IP>" ]]; then
  echo "[deploy] 未提供服务器 IP。真实值见 docs/private/ops.md，用法：PRODUCTION_SERVER_IP=… $0" >&2
  exit 1
fi

# ---- 前置检查：构建产物存在 ----
if [ ! -d "${PROJECT_DIR}/dist" ]; then
  echo "[deploy] 未找到 dist/，请先在本地执行 npm run build" >&2
  exit 1
fi

# ---- 同步 dist/（只推构建产物，排除敏感与备份）----
echo "[deploy] 同步 dist/ → ${DEPLOY_USER}@${SERVER_IP}:${REMOTE_DIR}/"
rsync -az --delete \
  --exclude .git --exclude .env --exclude backups \
  -e "ssh -i ${SSH_KEY}" \
  "${PROJECT_DIR}/dist/" "${DEPLOY_USER}@${SERVER_IP}:${REMOTE_DIR}/"

echo "[deploy] 完成。Caddy 直接伺服该目录，无需重启；"
echo "        仅当改动服务器 Caddyfile 后才需 caddy reload。"
