# deploy.env — 部署五事实（本文件位于 docs/private/，永不入库、永不提交）
# 三事实分离：本地目录名 ≠ 项目名 ≠ 服务器账号，以下各项独立填写
PROJECT_NAME=""        # 项目名（容器/compose project 名）
DEPLOY_USER=""         # 服务器专用账号
REMOTE_DIR=""          # 服务器目录，如 /opt/<项目名>
SERVER_IP=""           # 生产服务器 IP
DEPLOY_KEY=""          # 本地 SSH 私钥路径，如 ~/.ssh/<项目名>_deploy
# 静态站专用：发布目录（Vite/Astro=dist，Next.js 静态导出=out，纯 HTML=public）
# STATIC_OUTPUT_DIR="dist"
